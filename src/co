use anyhow::{Context, Result};
use dotenvy::dotenv;
use std::env;

#[derive(Debug)]
pub struct Config {
    pub listen: String,
    pub proxy_upstream: String,
}

pub fn load() -> Result<Config> {
    dotenv().ok();

    let listen = env::var("LISTEN").unwrap_or("0.0.0.0:3000".to_string());

    let proxy_upstream = env::var("PROXY_UPSTREAM")
        .with_context(|| "PROXY_UPSTREAM env var is required (e.g. http://localhost:8000)")?;

    Ok(Config {
        listen,
        proxy_upstream,
    })
}
